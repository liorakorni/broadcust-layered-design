{
  "Comment": "LayeredDesign pipeline. State carries only jobId, stage, attempt and small artifact pointers - never image bytes or HTML.",
  "StartAt": "Preflight",
  "TimeoutSeconds": 1800,
  "States": {
    "Preflight": {
      "Type": "Task",
      "Resource": "${StageFunctionArn}",
      "Parameters": {
        "jobId.$": "$.jobId",
        "stage": "PREFLIGHT",
        "attempt": 1,
        "assetId": null
      },
      "ResultPath": "$.preflight",
      "Retry": [
        {
          "ErrorEquals": [
            "ProviderError",
            "ProviderTimeout",
            "ProviderRateLimited"
          ],
          "IntervalSeconds": 5,
          "MaxAttempts": 2,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.failure",
          "Next": "RecordFailure"
        }
      ],
      "Next": "PrepareCopy"
    },
    "PrepareCopy": {
      "Type": "Task",
      "Resource": "${StageFunctionArn}",
      "Parameters": {
        "jobId.$": "$.jobId",
        "stage": "PREPARE_COPY",
        "attempt": 1,
        "assetId": null
      },
      "ResultPath": "$.prepareCopy",
      "Retry": [
        {
          "ErrorEquals": [
            "ProviderError",
            "ProviderTimeout",
            "ProviderRateLimited",
            "InvalidModelJson"
          ],
          "IntervalSeconds": 5,
          "MaxAttempts": 2,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.failure",
          "Next": "RecordFailure"
        }
      ],
      "Next": "AnalyzeReference"
    },
    "AnalyzeReference": {
      "Type": "Task",
      "Resource": "${StageFunctionArn}",
      "Comment": "Vision over the real reference pixels; persists policy.json and reference-analysis.json. Runs once: the policy depends only on the request.",
      "Parameters": {
        "jobId.$": "$.jobId",
        "stage": "ANALYZE_REFERENCE",
        "attempt": 1,
        "assetId": null
      },
      "ResultPath": "$.referenceAnalysis",
      "Retry": [
        {
          "ErrorEquals": [
            "ProviderError",
            "ProviderTimeout",
            "ProviderRateLimited",
            "InvalidModelJson",
            "ReferenceFetchFailed"
          ],
          "IntervalSeconds": 5,
          "MaxAttempts": 2,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.failure",
          "Next": "RecordFailure"
        }
      ],
      "Next": "FlowChoice"
    },
    "Concept": {
      "Type": "Task",
      "Resource": "${StageFunctionArn}",
      "Parameters": {
        "jobId.$": "$.jobId",
        "stage": "CONCEPT",
        "assetId": null,
        "attempt.$": "$.attempt"
      },
      "ResultPath": "$.concept",
      "Comment": "Paid image generation. ProviderOutcomeUnknown is deliberately NOT retried - a retry is exactly what would pay twice.",
      "Retry": [
        {
          "ErrorEquals": [
            "ProviderRateLimited"
          ],
          "IntervalSeconds": 20,
          "MaxAttempts": 2,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.failure",
          "Next": "RecordFailure"
        }
      ],
      "Next": "ReviewConcept"
    },
    "ReviewConcept": {
      "Type": "Task",
      "Resource": "${StageFunctionArn}",
      "Comment": "Compares reference and concept against the derived policy before any paid separation work. Approval is computed by the backend; an approved concept is frozen on the job.",
      "Parameters": {
        "jobId.$": "$.jobId",
        "stage": "REVIEW_CONCEPT",
        "attempt.$": "$.attempt",
        "assetId": null
      },
      "ResultPath": "$.conceptReview",
      "Retry": [
        {
          "ErrorEquals": [
            "ProviderError",
            "ProviderTimeout",
            "ProviderRateLimited",
            "InvalidModelJson",
            "ReferenceFetchFailed"
          ],
          "IntervalSeconds": 5,
          "MaxAttempts": 2,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.failure",
          "Next": "RecordFailure"
        }
      ],
      "Next": "ConceptApproved"
    },
    "ConceptApproved": {
      "Type": "Choice",
      "Comment": "An eligible candidate was selected and frozen: continue to ExtractScene. Otherwise, while a concept round remains, go to CorrectConcept (which plans a targeted edit of the best stored candidate). When no round remains go to SelectConcept, which re-evaluates every stored candidate under the current policy and selects the best eligible one - or fails with a precise reason. Neither may go to RecordFailure directly: that state reads $.failure, which only a Catch sets, so a direct edge ends the execution with States.Runtime and leaves the job RUNNING forever.",
      "Choices": [
        {
          "Variable": "$.conceptReview.artifacts.approved",
          "BooleanEquals": true,
          "Next": "ExtractScene"
        },
        {
          "Variable": "$.conceptReview.artifacts.correctionAvailable",
          "BooleanEquals": false,
          "Next": "SelectConcept"
        }
      ],
      "Default": "CorrectConcept"
    },
    "CorrectConcept": {
      "Type": "Task",
      "Resource": "${StageFunctionArn}",
      "Comment": "Consumes one bounded concept round (separate from the HTML correction rounds). The counter is bounded per job in DynamoDB, not per task retry.",
      "Parameters": {
        "jobId.$": "$.jobId",
        "stage": "REVIEW_CONCEPT",
        "attempt.$": "$.attempt",
        "assetId": null,
        "operation": "CORRECT_CONCEPT"
      },
      "ResultPath": "$.conceptCorrection",
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.failure",
          "Next": "RecordFailure"
        }
      ],
      "Next": "NextConceptAttempt"
    },
    "NextConceptAttempt": {
      "Type": "Pass",
      "Comment": "Advances the attempt counter and drops stale per-attempt state. The concept is regenerated, so scene, assets, render and QA from the previous attempt are invalidated.",
      "Parameters": {
        "jobId.$": "$.jobId",
        "attempt.$": "$.conceptCorrection.artifacts.nextAttempt"
      },
      "Next": "Concept"
    },
    "ExtractScene": {
      "Type": "Task",
      "Resource": "${StageFunctionArn}",
      "Parameters": {
        "jobId.$": "$.jobId",
        "stage": "EXTRACT_SCENE",
        "attempt.$": "$.attempt",
        "assetId": null
      },
      "ResultPath": "$.scene",
      "Retry": [
        {
          "ErrorEquals": [
            "InvalidModelJson",
            "ProviderError",
            "ProviderTimeout",
            "ProviderRateLimited"
          ],
          "IntervalSeconds": 5,
          "MaxAttempts": 2,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.failure",
          "Next": "RecordFailure"
        }
      ],
      "Next": "DecorationOverlay"
    },
    "DecorationOverlay": {
      "Type": "Task",
      "Resource": "${StageFunctionArn}",
      "Parameters": {
        "jobId.$": "$.jobId",
        "stage": "DECORATION_OVERLAY",
        "attempt.$": "$.attempt",
        "assetId": null
      },
      "Retry": [
        {
          "ErrorEquals": [
            "ProviderRateLimited"
          ],
          "IntervalSeconds": 20,
          "MaxAttempts": 2,
          "BackoffRate": 2
        }
      ],
      "ResultPath": "$.decoration",
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.failure",
          "Next": "RecordFailure"
        }
      ],
      "Next": "CleanPhoto",
      "Comment": "Runs before CleanPhoto: the photo is repainted only where this overlay (and the scene's text boxes) cover it, so the visible photograph keeps its exact framing."
    },
    "CleanPhoto": {
      "Type": "Task",
      "Resource": "${StageFunctionArn}",
      "Parameters": {
        "jobId.$": "$.jobId",
        "stage": "CLEAN_PHOTO",
        "attempt.$": "$.attempt",
        "assetId": null
      },
      "Retry": [
        {
          "ErrorEquals": [
            "ProviderRateLimited"
          ],
          "IntervalSeconds": 20,
          "MaxAttempts": 2,
          "BackoffRate": 2
        }
      ],
      "ResultPath": "$.photo",
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.failure",
          "Next": "RecordFailure"
        }
      ],
      "Next": "IndependentAssets",
      "Comment": "Edits the immutable concept under a mask. Never fed the overlay's pixels - only the shape of its alpha."
    },
    "IndependentAssets": {
      "Type": "Map",
      "Comment": "At most three independent assets, concurrency two (SPEC section 4).",
      "ItemsPath": "$.scene.artifacts.independentAssetIds",
      "MaxConcurrency": 2,
      "ResultPath": "$.independentAssets",
      "Parameters": {
        "jobId.$": "$.jobId",
        "stage": "INDEPENDENT_ASSETS",
        "attempt.$": "$.attempt",
        "assetId.$": "$$.Map.Item.Value"
      },
      "Iterator": {
        "StartAt": "IndependentAsset",
        "States": {
          "IndependentAsset": {
            "Type": "Task",
            "Resource": "${StageFunctionArn}",
            "Retry": [
              {
                "ErrorEquals": [
                  "ProviderRateLimited"
                ],
                "IntervalSeconds": 20,
                "MaxAttempts": 2,
                "BackoffRate": 2
              }
            ],
            "End": true
          }
        }
      },
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.failure",
          "Next": "RecordFailure"
        }
      ],
      "Next": "ValidateAssets"
    },
    "ValidateAssets": {
      "Type": "Task",
      "Resource": "${StageFunctionArn}",
      "Parameters": {
        "jobId.$": "$.jobId",
        "stage": "VALIDATE_ASSETS",
        "attempt.$": "$.attempt",
        "assetId": null
      },
      "ResultPath": "$.validation",
      "Catch": [
        {
          "ErrorEquals": [
            "OverlayRepairNeeded"
          ],
          "ResultPath": "$.repairNeeded",
          "Next": "RepairOverlay"
        },
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.failure",
          "Next": "RecordFailure"
        }
      ],
      "Next": "Assemble"
    },
    "RepairOverlay": {
      "Type": "Task",
      "Resource": "${StageFunctionArn}",
      "Comment": "Bounded targeted overlay repair (SPEC section 4). The repair count is held on the job, not here, so task retries cannot buy extra rounds.",
      "Parameters": {
        "jobId.$": "$.jobId",
        "stage": "DECORATION_OVERLAY",
        "attempt.$": "$.attempt",
        "assetId": null,
        "operation": "REPAIR_OVERLAY"
      },
      "ResultPath": "$.overlayRepair",
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.failure",
          "Next": "RecordFailure"
        }
      ],
      "Next": "RebuildPhoto"
    },
    "RebuildPhoto": {
      "Type": "Task",
      "Resource": "${StageFunctionArn}",
      "Comment": "After an overlay repair the photo is repainted around the repaired overlay, so the two layers stay consistent.",
      "Parameters": {
        "jobId.$": "$.jobId",
        "stage": "CLEAN_PHOTO",
        "attempt.$": "$.attempt",
        "assetId": null,
        "operation": "REBUILD_PHOTO"
      },
      "ResultPath": "$.photoRebuild",
      "Retry": [
        {
          "ErrorEquals": [
            "ProviderRateLimited"
          ],
          "IntervalSeconds": 20,
          "MaxAttempts": 2,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.failure",
          "Next": "RecordFailure"
        }
      ],
      "Next": "ValidateAssets"
    },
    "Assemble": {
      "Type": "Task",
      "Resource": "${StageFunctionArn}",
      "Parameters": {
        "jobId.$": "$.jobId",
        "stage": "ASSEMBLE",
        "attempt.$": "$.attempt",
        "assetId": null
      },
      "ResultPath": "$.assemble",
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.failure",
          "Next": "RecordFailure"
        }
      ],
      "Next": "Render"
    },
    "Render": {
      "Type": "Task",
      "Resource": "${StageFunctionArn}",
      "Parameters": {
        "jobId.$": "$.jobId",
        "stage": "RENDER",
        "attempt.$": "$.attempt",
        "assetId": null
      },
      "ResultPath": "$.render",
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.failure",
          "Next": "RecordFailure"
        }
      ],
      "Next": "Review"
    },
    "Review": {
      "Type": "Task",
      "Resource": "${StageFunctionArn}",
      "Parameters": {
        "jobId.$": "$.jobId",
        "stage": "REVIEW",
        "attempt.$": "$.attempt",
        "assetId": null
      },
      "ResultPath": "$.review",
      "Retry": [
        {
          "ErrorEquals": [
            "InvalidModelJson",
            "ProviderError",
            "ProviderTimeout"
          ],
          "IntervalSeconds": 5,
          "MaxAttempts": 2,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.failure",
          "Next": "RecordFailure"
        }
      ],
      "Next": "ReviewPassed"
    },
    "ReviewPassed": {
      "Type": "Choice",
      "Comment": "Backend approval needs zero blocking issues AND passing technical checks. The stage computes this; a model asserting passed:true cannot override it. Anything not approved is routed by the validated classification of its findings (route in the review result): 'light' (content/typography/layout) goes to RepairLight, which patches the design and never calls an image model; 'asset' goes to RepairAsset, which regenerates only the named photograph or overlay; a review that traces its blockers to the approved concept itself goes to CorrectConcept. Every other route (unresolved, exhausted, noProgress) goes to Correct, which stops with a specific diagnostic naming the preserved candidate. None of them may go to RecordFailure directly: that state reads $.failure, which only a Catch sets, so a direct edge ends the execution with States.Runtime and leaves the job RUNNING forever.",
      "Choices": [
        {
          "Variable": "$.review.artifacts.approved",
          "BooleanEquals": true,
          "Next": "Finalize"
        },
        {
          "Variable": "$.review.artifacts.conceptDefect",
          "BooleanEquals": true,
          "Next": "CorrectConcept"
        },
        {
          "Variable": "$.review.artifacts.route",
          "StringEquals": "light",
          "Next": "RepairLight"
        },
        {
          "Variable": "$.review.artifacts.route",
          "StringEquals": "asset",
          "Next": "RepairAsset"
        }
      ],
      "Default": "Correct"
    },
    "Correct": {
      "Type": "Task",
      "Resource": "${StageFunctionArn}",
      "Comment": "Terminal step for a review that cannot be repaired within budget (unresolved, exhausted or no progress). It never regenerates anything. It delivers the best usable candidate with its unresolved findings (SUCCEEDED_WITH_WARNINGS, publishReady false) and records why; only when no candidate is usable does it raise the precise error, which RecordFailure persists.",
      "Parameters": {
        "jobId.$": "$.jobId",
        "stage": "REVIEW",
        "attempt.$": "$.attempt",
        "assetId": null,
        "operation": "CORRECT"
      },
      "ResultPath": "$.correction",
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.failure",
          "Next": "RecordFailure"
        }
      ],
      "Next": "Succeeded"
    },
    "Finalize": {
      "Type": "Task",
      "Resource": "${StageFunctionArn}",
      "Parameters": {
        "jobId.$": "$.jobId",
        "stage": "FINALIZE",
        "attempt.$": "$.attempt",
        "assetId": null
      },
      "ResultPath": "$.finalize",
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.failure",
          "Next": "RecordFailure"
        }
      ],
      "Next": "Succeeded"
    },
    "Succeeded": {
      "Type": "Succeed"
    },
    "RecordFailure": {
      "Type": "Task",
      "Resource": "${StageFunctionArn}",
      "Comment": "Persists the terminal stage/code/message on the job so getLayeredDesignStatus can report it - unless an earlier usable candidate could be delivered instead, in which case the job is SUCCEEDED_WITH_WARNINGS with the original error in its diagnostics. Always returns artifacts.salvaged.",
      "Parameters": {
        "jobId.$": "$.jobId",
        "stage": "FINALIZE",
        "attempt": 1,
        "assetId": null,
        "recordFailure": true,
        "failure.$": "$.failure"
      },
      "ResultPath": "$.recorded",
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.recordError",
          "Next": "Failed"
        }
      ],
      "Next": "FailureOutcome"
    },
    "Failed": {
      "Type": "Fail",
      "Comment": "The job record already carries the structured error; this just ends the execution."
    },
    "SelectConcept": {
      "Type": "Task",
      "Resource": "${StageFunctionArn}",
      "Comment": "Retry exhaustion. Every stored concept candidate is evaluated under the CURRENT policy (stored verdicts are re-decided; candidates reviewed under another policy version are reviewed again, with the reevaluation stored beside the original). The best ELIGIBLE candidate is frozen with its selection reason; the latest attempt is never chosen merely for being latest. With no eligible candidate it raises RequiredCopyMissing (content) or ReferenceAdherenceFailed (structure).",
      "Parameters": {
        "jobId.$": "$.jobId",
        "stage": "REVIEW_CONCEPT",
        "attempt.$": "$.attempt",
        "assetId": null,
        "operation": "SELECT_CONCEPT"
      },
      "ResultPath": "$.conceptSelection",
      "Retry": [
        {
          "ErrorEquals": [
            "ProviderError",
            "ProviderTimeout",
            "ProviderRateLimited",
            "InvalidModelJson",
            "ReferenceFetchFailed"
          ],
          "IntervalSeconds": 5,
          "MaxAttempts": 2,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.failure",
          "Next": "RecordFailure"
        }
      ],
      "Next": "ExtractScene"
    },
    "RepairLight": {
      "Type": "Task",
      "Resource": "${StageFunctionArn}",
      "Comment": "Lightweight text/layout repair. Loads the selected design snapshot, patches only the affected content/typography/layout fields, keeps every asset reference and hash, and makes no image-generation call. The budget is bounded per job in DynamoDB.",
      "Parameters": {
        "jobId.$": "$.jobId",
        "stage": "REVIEW",
        "attempt.$": "$.attempt",
        "assetId": null,
        "operation": "REPAIR_LIGHT"
      },
      "ResultPath": "$.repair",
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.failure",
          "Next": "RecordFailure"
        }
      ],
      "Next": "NextRepairAttempt"
    },
    "RepairAsset": {
      "Type": "Task",
      "Resource": "${StageFunctionArn}",
      "Comment": "Plans a targeted regeneration of exactly the asset the review named and spends the asset budget. Makes no image call itself.",
      "Parameters": {
        "jobId.$": "$.jobId",
        "stage": "REVIEW",
        "attempt.$": "$.attempt",
        "assetId": null,
        "operation": "REPAIR_ASSET"
      },
      "ResultPath": "$.repair",
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.failure",
          "Next": "RecordFailure"
        }
      ],
      "Next": "NextRepairAttempt"
    },
    "NextRepairAttempt": {
      "Type": "Pass",
      "Comment": "Advances the attempt. A light repair resumes at AssembleHTML: the patched design is assembled and rendered, then re-reviewed, without touching CONCEPT, EXTRACT_SCENE, CLEAN_PHOTO or DECORATION_OVERLAY.",
      "Parameters": {
        "jobId.$": "$.jobId",
        "attempt.$": "$.repair.artifacts.nextAttempt",
        "repair.$": "$.repair.artifacts"
      },
      "Next": "RepairRoute"
    },
    "RepairRoute": {
      "Type": "Choice",
      "Comment": "After a repair: a light repair re-assembles; a photo repair regenerates the photograph then re-validates; an overlay repair regenerates the overlay, rebuilds the photograph around it, then re-validates.",
      "Choices": [
        {
          "Variable": "$.repair.next",
          "StringEquals": "photo",
          "Next": "RepairPhoto"
        },
        {
          "Variable": "$.repair.next",
          "StringEquals": "overlay",
          "Next": "RepairOverlay"
        }
      ],
      "Default": "Assemble"
    },
    "RepairPhoto": {
      "Type": "Task",
      "Resource": "${StageFunctionArn}",
      "Comment": "Regenerates only the photograph, with the review's finding as the instruction. The scene, overlay and all other assets are untouched.",
      "Parameters": {
        "jobId.$": "$.jobId",
        "stage": "CLEAN_PHOTO",
        "attempt.$": "$.attempt",
        "assetId": null,
        "operation": "REPAIR_PHOTO"
      },
      "ResultPath": "$.photoRepair",
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.failure",
          "Next": "RecordFailure"
        }
      ],
      "Next": "ValidateAssets",
      "Retry": [
        {
          "ErrorEquals": [
            "ProviderError",
            "ProviderTimeout"
          ],
          "IntervalSeconds": 5,
          "MaxAttempts": 1,
          "BackoffRate": 2
        }
      ]
    },
    "FlowChoice": {
      "Type": "Choice",
      "Comment": "The layout-first flow (feature flag; Phase B) plans an editable layout and generates only the text-free photograph. It never enters CONCEPT, EXTRACT_SCENE, DECORATION_OVERLAY or CLEAN_PHOTO. Executions without a flow field are the legacy flow.",
      "Choices": [
        {
          "And": [
            {
              "Variable": "$.flow",
              "IsPresent": true
            },
            {
              "Variable": "$.flow",
              "StringEquals": "layout-first"
            }
          ],
          "Next": "PlanLayout"
        }
      ],
      "Default": "Concept"
    },
    "PlanLayout": {
      "Type": "Task",
      "Resource": "${StageFunctionArn}",
      "Parameters": {
        "jobId.$": "$.jobId",
        "stage": "PLAN_LAYOUT",
        "attempt.$": "$.attempt",
        "assetId": null
      },
      "ResultPath": "$.layout",
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.failure",
          "Next": "RecordFailure"
        }
      ],
      "Next": "GeneratePhoto",
      "Retry": [
        {
          "ErrorEquals": [
            "InvalidModelJson",
            "ProviderError",
            "ProviderTimeout"
          ],
          "IntervalSeconds": 5,
          "MaxAttempts": 2,
          "BackoffRate": 2
        }
      ],
      "Comment": "Layout-first: plans the editable layout and the text-free photo brief."
    },
    "GeneratePhoto": {
      "Type": "Task",
      "Resource": "${StageFunctionArn}",
      "Parameters": {
        "jobId.$": "$.jobId",
        "stage": "GENERATE_PHOTO",
        "attempt.$": "$.attempt",
        "assetId": null
      },
      "ResultPath": "$.photo",
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.failure",
          "Next": "RecordFailure"
        }
      ],
      "Next": "ValidateAssets",
      "Retry": [
        {
          "ErrorEquals": [
            "ProviderError",
            "ProviderTimeout"
          ],
          "IntervalSeconds": 5,
          "MaxAttempts": 1,
          "BackoffRate": 2
        }
      ],
      "Comment": "Layout-first: the only generated image."
    },
    "FailureOutcome": {
      "Type": "Choice",
      "Comment": "RecordFailure always answers artifacts.salvaged (a choice on an absent path fails the execution uncatchably). A salvaged job delivered a design, so the execution succeeds; otherwise it fails.",
      "Choices": [
        {
          "Variable": "$.recorded.artifacts.salvaged",
          "BooleanEquals": true,
          "Next": "Succeeded"
        }
      ],
      "Default": "Failed"
    }
  }
}
